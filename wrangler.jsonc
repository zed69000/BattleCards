{
  // Cloudflare publie public/ tel quel ; seuls /ws et /api passent par worker/index.js (parties en ligne, classement).
  "name": "battlecards",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }, { "name": "BOARD", "class_name": "Board" }] },
  // Stockage SQLite : la seule forme de Durable Object incluse dans l'offre gratuite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }, { "tag": "v2", "new_sqlite_classes": ["Board"] }]
}
